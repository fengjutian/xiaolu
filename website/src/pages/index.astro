---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../config/site";
import {
  Activity,
  ArrowRight,
  Check,
  Cpu,
  Eraser,
  ExternalLink,
  FileArchive,
  Gauge,
  ShieldCheck,
  SlidersHorizontal,
  Sparkles,
  Stethoscope,
} from "lucide-react";

const features = [
  { icon: Activity, title: "实时状态", label: "LIVE", text: "CPU、内存、磁盘和网络每 2 秒刷新，变化不再藏在任务管理器深处。", href: "/features/#monitor", className: "feature-wide" },
  { icon: Cpu, title: "硬件健康", label: "HEALTH", text: "温度、SMART、驱动签名和设备状态，集中到一张清晰的健康视图。", href: "/features/#hardware", className: "" },
  { icon: Stethoscope, title: "问题诊断", label: "DIAGNOSE", text: "把蓝屏、崩溃、网络和驱动异常整理成能读懂、能追查的结论。", href: "/features/#diagnostics", className: "" },
  { icon: Gauge, title: "性能基线", label: "BENCHMARK", text: "不只给一个跑分，还记录本机历史基线，让每次变快或变慢都有参照。", href: "/features/#benchmark", className: "feature-wide" },
  { icon: Eraser, title: "空间与清理", label: "STORAGE", text: "Treemap、目录钻取和大文件定位；清理前预览，清理后进入回收站。", href: "/toolbox/#cleanup", className: "" },
  { icon: Sparkles, title: "AI 解读", label: "OPTIONAL", text: "默认关闭。开启后只读取脱敏快照，每条结论都必须附上证据。", href: "/ai/", className: "" },
];

const guarantees = ["本地优先", "无需注册", "不装后台服务", "写操作可回滚"];
---

<Layout title="小鲁 · 系统透镜 — 看清你的电脑" description="面向 Windows 的本地系统信息、健康检查、性能诊断与 AI 解读工具。">
  <main class="home" id="top">
    <section class="home-hero section-shell">
      <div class="hero-orb hero-orb-one"></div>
      <div class="hero-orb hero-orb-two"></div>

      <div class="home-hero-copy">
        <div class="eyebrow"><i></i> WINDOWS 11 · VERSION {SITE.version}</div>
        <h1>别再猜电脑<br />哪里<em>不对劲。</em></h1>
        <p>小鲁把硬件状态、实时性能、问题诊断和空间占用放进同一个清晰视图。你看到的不只是数字，还有它意味着什么。</p>
        <div class="hero-actions home-actions">
          <a class="button primary" href="/download/">下载 Windows 版 <ArrowRight size={17} /></a>
          <a class="button secondary" href="/features/">查看全部能力</a>
        </div>
        <div class="hero-proof">
          {guarantees.map((item) => <span><Check size={14} strokeWidth={2.5} />{item}</span>)}
        </div>
      </div>

      <div class="product-stage">
        <div class="stage-label stage-label-top"><Activity size={14} /> 真实应用界面</div>
        <figure class="app-shot">
          <img src="/app-overview.png" alt="小鲁桌面应用的性能概览真实界面" width="1536" height="816" loading="eager" />
        </figure>
      </div>
    </section>

    <section class="value-strip section-shell" aria-label="产品原则">
      <div><strong>01</strong><span>读数有来源</span><small>拿不到就明确说明，不用估算值填空。</small></div>
      <div><strong>02</strong><span>判断有证据</span><small>从实时曲线一路追到事件与硬件状态。</small></div>
      <div><strong>03</strong><span>改动有退路</span><small>先预览、再确认，并保留审计和回滚路径。</small></div>
    </section>

    <section class="home-section section-shell" id="features">
      <div class="home-section-head">
        <div><div class="section-label">CAPABILITIES / 核心能力</div><h2>从“发生了什么”，<br />到“接下来怎么办”。</h2></div>
        <p>不把专业术语丢给你。每个视图都围绕一个问题展开，让系统状态真正可以被理解和行动。</p>
      </div>
      <div class="bento-grid">
        {features.map(({ icon: Icon, ...feature }) => (
          <a class:list={["bento-card", feature.className]} href={feature.href}>
            <div class="bento-top"><span class="bento-icon"><Icon size={22} strokeWidth={1.7} /></span><small>{feature.label}</small></div>
            <div><h3>{feature.title}</h3><p>{feature.text}</p></div>
            <ArrowRight className="bento-arrow" size={18} />
          </a>
        ))}
      </div>
    </section>

    <section class="insight-v2 section-shell">
      <div class="insight-v2-copy">
        <div class="section-label">CONTEXT / 趋势与上下文</div>
        <h2>一次读数没意义，<br />变化才有。</h2>
        <p>实时数据、历史趋势和健康评估被放在同一个上下文里。温度升高、磁盘空间减少或系统开始不稳定时，你能看见变化发生的过程。</p>
        <a href="/features/#monitor">了解实时监控 <ArrowRight size={15} /></a>
      </div>
      <div class="chart-card chart-card-v2" aria-label="CPU 使用率趋势示意图">
        <div class="chart-head"><span><Activity size={15} /> CPU 使用率</span><small><i></i> 实时</small></div>
        <div class="chart-value">27.4% <span>状态平稳</span></div>
        <svg viewBox="0 0 560 190" role="img" aria-label="CPU 使用率趋势模拟图"><defs><linearGradient id="area" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#7585ff" stop-opacity=".35"/><stop offset="1" stop-color="#7585ff" stop-opacity="0"/></linearGradient></defs><path class="grid" d="M0 40H560M0 90H560M0 140H560"/><path class="area" d="M0 145 C45 130 58 90 95 112 S145 165 185 118 S245 62 285 94 S340 150 380 120 S430 62 470 82 S525 120 560 70 V190H0Z"/><path class="line" d="M0 145 C45 130 58 90 95 112 S145 165 185 118 S245 62 285 94 S340 150 380 120 S430 62 470 82 S525 120 560 70"/></svg>
        <div class="chart-legend"><span>过去 60 分钟</span><span>现在</span></div>
      </div>
    </section>

    <section class="tools-v2 section-shell">
      <div class="tools-title">
        <div class="section-label">TOOLBOX / 独立工具</div>
        <h2>需要动手时，<br />边界依然清楚。</h2>
        <p>25 个工具各自声明权限和风险。只读能力不写入系统；写操作必须经过预览、确认和记录。</p>
        <a class="text-link" href="/toolbox/">浏览完整工具箱 <ArrowRight size={15} /></a>
      </div>
      <div class="tool-stack">
        <a href="/toolbox/#cleanup"><span><Eraser size={22} /></span><div><h3>清理与空间</h3><p>定位大文件、重复文件和固定白名单内的可清理项。</p></div><ArrowRight size={17} /></a>
        <a href="/toolbox/#optimize"><span><SlidersHorizontal size={22} /></span><div><h3>系统优化</h3><p>逐项体检与预览，保留原值和一键撤销路径。</p></div><ArrowRight size={17} /></a>
        <a href="/toolbox/#utility"><span><FileArchive size={22} /></span><div><h3>文件工具</h3><p>压缩、PDF 和日常文件处理，进度透明且可取消。</p></div><ArrowRight size={17} /></a>
      </div>
    </section>

    <section class="privacy-v2 section-shell">
      <div class="privacy-mark"><ShieldCheck size={38} strokeWidth={1.5} /></div>
      <div><div class="section-label">LOCAL-FIRST / 安全边界</div><h2>电脑数据，留在电脑。</h2><p>默认本地运行，不要求注册账户，不安装额外后台服务。报告导出时自动隐藏主机名、用户名、序列号和本地路径等敏感信息。</p></div>
      <a href="/security/">查看安全说明 <ArrowRight size={15} /></a>
    </section>

    <section class="download-v2 section-shell">
      <div><span>适用于 Windows 11 · v{SITE.version}</span><h2>把电脑的状态，<br />真正看明白。</h2></div>
      <a class="button download-button" href={SITE.releasesUrl}>前往 GitHub Releases <ExternalLink size={17} /></a>
    </section>
  </main>
</Layout>
