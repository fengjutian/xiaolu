{
  "schemaVersion": 1,
  "id": "c_expand",
  "name": "C 盘瘦身与扩容",
  "version": "0.2.0",
  "apiVersion": 1,
  "description": "分析卷与右侧未分配空间；支持 NTFS 卷向右扩展相邻空间（需 UAC）",
  "category": "存储",
  "risk": "system",
  "entry": "c_expand.exe",
  "arguments": ["--stdio"],
  "permissions": {
    "readPaths": [],
    "writePaths": [],
    "registry": [],
    "network": false,
    "elevation": "uac"
  },
  "actions": [
    { "id": "preview", "label": "分析", "write": false },
    { "id": "expand_volume", "label": "扩展卷（需 UAC）", "write": true, "requiresConfirmation": true }
  ],
  "limits": { "timeoutMs": 600000, "maxOutputBytes": 1048576 },
  "ui": { "kind": "table" },
  "rollback": "none",
  "hash": "",
  "signature": null
}
