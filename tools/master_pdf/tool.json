{
  "schemaVersion": 1,
  "id": "master_pdf",
  "name": "PDF 大师",
  "version": "0.2.0",
  "apiVersion": 1,
  "description": "逐页预览 PDF，查看信息，合并、拆分与旋转页面；支持输出加密、权限限制与同名冲突策略",
  "category": "工具箱",
  "risk": "write",
  "entry": "master_pdf.exe",
  "arguments": ["--stdio"],
  "permissions": {
    "readPaths": ["用户选择的 PDF 文件"],
    "writePaths": ["用户选择的输出 PDF"],
    "registry": [],
    "network": false,
    "elevation": "none"
  },
  "actions": [
    { "id": "info", "label": "查看信息", "write": false },
    { "id": "pages", "label": "页面预览", "write": false },
    { "id": "preview", "label": "预览", "write": false },
    { "id": "apply", "label": "合并/拆分/旋转", "write": true, "requiresConfirmation": true }
  ],
  "limits": { "timeoutMs": 180000, "maxOutputBytes": 2097152 },
  "ui": { "kind": "table" },
  "rollback": "none",
  "hash": "",
  "signature": null
}
