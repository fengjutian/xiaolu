{
  "schemaVersion": 1,
  "id": "driver_manager",
  "name": "驱动管理",
  "version": "0.2.0",
  "apiVersion": 1,
  "description": "检查驱动异常与 Windows Update 候选，可打开设备管理器/Windows 更新",
  "category": "driver",
  "risk": "read_only",
  "entry": "driver_manager.exe",
  "arguments": ["--stdio"],
  "permissions": {
    "readPaths": [],
    "writePaths": [],
    "registry": [],
    "network": true,
    "elevation": "none"
  },
  "actions": [
    { "id": "preview", "label": "预览", "write": false },
    { "id": "open_official", "label": "打开系统驱动界面", "write": false }
  ],
  "limits": { "timeoutMs": 180000, "maxOutputBytes": 4194304 },
  "ui": { "kind": "table" },
  "rollback": "none",
  "hash": "",
  "signature": null
}
