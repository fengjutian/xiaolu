{
  "schemaVersion": 1,
  "id": "clean_master",
  "name": "清理大师",
  "version": "0.3.0",
  "apiVersion": 1,
  "description": "扫描并勾选固定清理位置，文件移入回收站可还原",
  "category": "清理",
  "risk": "write",
  "entry": "clean_master.exe",
  "arguments": ["--stdio"],
  "permissions": {
    "readPaths": [
      "%TEMP%",
      "%WINDIR%\\Temp",
      "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer",
      "%LOCALAPPDATA%\\CrashDumps",
      "%LOCALAPPDATA%\\Microsoft\\Windows\\WER",
      "%ProgramData%\\Microsoft\\Windows\\WER",
      "%WINDIR%\\SoftwareDistribution\\Download",
      "%ProgramData%\\Microsoft\\Windows\\DeliveryOptimization\\Cache",
      "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\Default\\Cache",
      "%LOCALAPPDATA%\\Microsoft\\Windows\\INetCache",
      "%SystemDrive%\\$Recycle.Bin"
    ],
    "writePaths": [
      "%TEMP%",
      "%WINDIR%\\Temp",
      "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer\\thumbcache_*",
      "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer\\iconcache_*",
      "%LOCALAPPDATA%\\CrashDumps",
      "%LOCALAPPDATA%\\Microsoft\\Windows\\WER",
      "%ProgramData%\\Microsoft\\Windows\\WER",
      "%WINDIR%\\SoftwareDistribution\\Download",
      "%ProgramData%\\Microsoft\\Windows\\DeliveryOptimization\\Cache",
      "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\Default\\Cache"
    ],
    "registry": [],
    "network": false,
    "elevation": "none"
  },
  "actions": [
    { "id": "preview", "label": "扫描", "write": false },
    { "id": "apply", "label": "清理所选", "write": true, "requiresConfirmation": true }
  ],
  "limits": { "timeoutMs": 180000, "maxOutputBytes": 4194304 },
  "ui": { "kind": "table" },
  "rollback": "recycle_bin",
  "hash": "",
  "signature": null
}
