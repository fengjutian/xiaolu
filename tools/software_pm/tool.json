{
  "schemaVersion": 1,
  "id": "software_pm",
  "name": "软件权限管理",
  "version": "0.1.0",
  "apiVersion": 1,
  "description": "只读查看启动项、自动服务、计划任务、通知与防火墙规则",
  "category": "工具箱",
  "risk": "read_only",
  "entry": "software_pm.exe",
  "arguments": ["--stdio"],
  "permissions": {
    "readPaths": [],
    "writePaths": [],
    "registry": [
      "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run",
      "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run",
      "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Notifications\\Settings"
    ],
    "network": false,
    "elevation": "none"
  },
  "actions": [{ "id": "preview", "label": "预览", "write": false }],
  "limits": { "timeoutMs": 120000, "maxOutputBytes": 4194304 },
  "ui": { "kind": "table" },
  "rollback": "none",
  "hash": "",
  "signature": null
}
