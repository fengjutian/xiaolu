{
  "schemaVersion": 1,
  "id": "sys_boost",
  "name": "系统优化大师",
  "version": "0.1.0",
  "apiVersion": 1,
  "description": "只读汇总启动项、服务、计划任务、休眠、页面文件与临时文件候选",
  "category": "优化",
  "risk": "read_only",
  "entry": "sys_boost.exe",
  "arguments": ["--stdio"],
  "permissions": {
    "readPaths": ["%TEMP%"],
    "writePaths": [],
    "registry": [
      "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
      "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\RunOnce",
      "HKLM\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
      "HKLM\\Software\\Microsoft\\Windows\\CurrentVersion\\RunOnce",
      "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Power"
    ],
    "network": false,
    "elevation": "none"
  },
  "actions": [{ "id": "preview", "label": "扫描", "write": false }],
  "limits": { "timeoutMs": 120000, "maxOutputBytes": 1048576 },
  "ui": { "kind": "table" },
  "rollback": "none",
  "hash": "",
  "signature": null
}
