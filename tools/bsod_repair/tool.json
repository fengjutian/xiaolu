{
  "schemaVersion": 1,
  "id": "bsod_repair",
  "name": "蓝屏修复",
  "version": "0.2.0",
  "apiVersion": 1,
  "description": "查看转储与蓝屏事件，并可经 UAC 切换崩溃转储模式",
  "category": "repair",
  "risk": "system",
  "entry": "bsod_repair.exe",
  "arguments": ["--stdio"],
  "permissions": {
    "readPaths": ["%SystemRoot%\\Minidump"],
    "writePaths": [],
    "registry": ["HKLM\\SYSTEM\\CurrentControlSet\\Control\\CrashControl"],
    "network": false,
    "elevation": "none"
  },
  "actions": [
    { "id": "preview", "label": "预览", "write": false },
    { "id": "set_dump_mode", "label": "切换转储模式（需 UAC）", "write": true, "requiresConfirmation": true }
  ],
  "limits": { "timeoutMs": 120000, "maxOutputBytes": 1048576 },
  "ui": { "kind": "table" },
  "rollback": "custom",
  "hash": "",
  "signature": null
}
