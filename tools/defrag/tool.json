{
  "schemaVersion": 1,
  "id": "defrag",
  "name": "磁盘碎片整理",
  "version": "0.2.1",
  "apiVersion": 1,
  "description": "查看磁盘介质与 TRIM；HDD 优化、SSD TRIM 需管理员授权",
  "category": "optimize",
  "risk": "system",
  "entry": "defrag.exe",
  "arguments": ["--stdio"],
  "permissions": {
    "readPaths": [],
    "writePaths": [],
    "registry": [],
    "network": false,
    "elevation": "uac"
  },
  "actions": [
    { "id": "preview", "label": "预览", "write": false },
    { "id": "optimize_disk", "label": "分析/优化/TRIM（需 UAC）", "write": true, "requiresConfirmation": true }
  ],
  "limits": { "timeoutMs": 3600000, "maxOutputBytes": 2097152 },
  "ui": { "kind": "table" },
  "rollback": "none",
  "hash": "",
  "signature": null
}
