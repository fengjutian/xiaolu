{
  "schemaVersion": 1,
  "id": "privacy_protection",
  "name": "隐私保护",
  "version": "0.2.0",
  "apiVersion": 1,
  "description": "检查诊断数据、广告 ID 与位置/相机/麦克风权限，4 项用户级设置可应用与撤销",
  "category": "privacy",
  "risk": "write",
  "entry": "privacy_protection.exe",
  "arguments": ["--stdio"],
  "permissions": {
    "readPaths": [],
    "writePaths": [],
    "registry": [
      "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
      "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo",
      "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\CapabilityAccessManager\\ConsentStore"
    ],
    "network": false,
    "elevation": "none"
  },
  "actions": [
    { "id": "preview", "label": "预览", "write": false },
    { "id": "apply_settings", "label": "应用隐私设置", "write": true, "requiresConfirmation": true }
  ],
  "limits": { "timeoutMs": 60000, "maxOutputBytes": 1048576 },
  "ui": { "kind": "table" },
  "rollback": "custom",
  "hash": "",
  "signature": null
}
