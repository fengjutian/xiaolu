{
  "schemaVersion": 1,
  "id": "pc_optimizer",
  "name": "电脑性能优化",
  "version": "0.2.0",
  "apiVersion": 1,
  "description": "预览并切换 Windows 活动电源计划",
  "category": "优化",
  "risk": "system",
  "entry": "pc_optimizer.exe",
  "arguments": ["--stdio"],
  "permissions": {
    "readPaths": [],
    "writePaths": [],
    "registry": [],
    "network": false,
    "elevation": "none"
  },
  "actions": [
    { "id": "preview", "label": "预览", "write": false },
    { "id": "apply", "label": "切换电源计划", "write": true, "requiresConfirmation": true },
    { "id": "apply_settings", "label": "应用电源设置", "write": true, "requiresConfirmation": true }
  ],
  "limits": { "timeoutMs": 30000, "maxOutputBytes": 262144 },
  "ui": { "kind": "table" },
  "rollback": "custom",
  "hash": "",
  "signature": null
}
