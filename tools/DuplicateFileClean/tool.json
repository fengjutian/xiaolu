{
  "schemaVersion": 1,
  "id": "DuplicateFileClean",
  "name": "重复文件清理",
  "version": "0.2.0",
  "apiVersion": 1,
  "description": "扫描下载/文档/桌面的重复文件，选择保留项后将其余移入回收站",
  "category": "cleanup",
  "risk": "write",
  "entry": "DuplicateFileClean.exe",
  "arguments": ["--stdio"],
  "permissions": {
    "readPaths": ["%USERPROFILE%\\Downloads", "%USERPROFILE%\\Documents", "%USERPROFILE%\\Desktop"],
    "writePaths": ["%USERPROFILE%\\Downloads", "%USERPROFILE%\\Documents", "%USERPROFILE%\\Desktop"],
    "registry": [],
    "network": false,
    "elevation": "none"
  },
  "actions": [
    { "id": "preview", "label": "扫描", "write": false },
    { "id": "clean_group", "label": "清理该组其余文件", "write": true, "requiresConfirmation": true }
  ],
  "limits": { "timeoutMs": 180000, "maxOutputBytes": 4194304 },
  "ui": { "kind": "table" },
  "rollback": "recycle_bin",
  "hash": "",
  "signature": null
}
