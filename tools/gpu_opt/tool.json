{
  "schemaVersion": 1,
  "id": "gpu_opt",
  "name": "显卡性能优化",
  "version": "0.2.0",
  "apiVersion": 1,
  "description": "查看显卡/驱动/电源计划，并按应用设置 GPU 偏好（HKCU，可恢复默认）",
  "category": "optimize",
  "risk": "write",
  "entry": "gpu_opt.exe",
  "arguments": ["--stdio"],
  "permissions": {
    "readPaths": [],
    "writePaths": [],
    "registry": [],
    "network": false,
    "elevation": "none"
  },
  "actions": [
    { "id": "preview", "label": "预览", "write": false },
    { "id": "set_gpu_preference", "label": "设置应用 GPU 偏好", "write": true, "requiresConfirmation": true }
  ],
  "limits": { "timeoutMs": 60000, "maxOutputBytes": 1048576 },
  "ui": { "kind": "table" },
  "rollback": "none",
  "hash": "",
  "signature": null
}
