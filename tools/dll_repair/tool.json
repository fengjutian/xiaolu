{
  "schemaVersion": 1,
  "id": "dll_repair",
  "name": "DLL 修复",
  "version": "0.1.0",
  "apiVersion": 1,
  "description": "只读检查常见运行库 DLL 是否存在",
  "category": "repair",
  "risk": "read_only",
  "entry": "dll_repair.exe",
  "arguments": ["--stdio"],
  "permissions": {
    "readPaths": ["%SystemRoot%\\System32", "%SystemRoot%\\SysWOW64"],
    "writePaths": [],
    "registry": [],
    "network": false,
    "elevation": "none"
  },
  "actions": [{ "id": "preview", "label": "预览", "write": false }],
  "limits": { "timeoutMs": 60000, "maxOutputBytes": 1048576 },
  "ui": { "kind": "table" },
  "rollback": "none",
  "hash": "",
  "signature": null
}
