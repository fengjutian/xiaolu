{
  "schemaVersion": 1,
  "id": "dll_repair",
  "name": "DLL 修复",
  "version": "0.2.0",
  "apiVersion": 1,
  "description": "检查运行库 DLL 与 VC++/.NET 安装状态，可打开微软官方下载页"
,
  "category": "repair",
  "risk": "read_only",
  "entry": "dll_repair.exe",
  "arguments": ["--stdio"],
  "permissions": {
    "readPaths": ["%SystemRoot%\\System32", "%SystemRoot%\\SysWOW64"],
    "writePaths": [],
    "registry": [
      "HKLM\\SOFTWARE\\Microsoft\\VisualStudio\\14.0\\VC\\Runtimes",
      "HKLM\\SOFTWARE\\Microsoft\\NET Framework Setup\\NDP\\v4\\Full"
    ],
    "network": false,
    "elevation": "none"
  },
  "actions": [
    { "id": "preview", "label": "预览", "write": false },
    { "id": "open_official", "label": "打开官方下载页", "write": false }
  ],
  "limits": { "timeoutMs": 60000, "maxOutputBytes": 1048576 },
  "ui": { "kind": "table" },
  "rollback": "none",
  "hash": "",
  "signature": null
}
