{
  "schemaVersion": 1,
  "id": "ai_cooling",
  "name": "AI 智能降温",
  "version": "0.2.0",
  "apiVersion": 1,
  "description": "查看 ACPI 温度与 CPU 负载；可按次提权读取 ACPI 风扇/探针与 SMART 磁盘信息",
  "category": "optimize",
  "risk": "read_only",
  "entry": "ai_cooling.exe",
  "arguments": ["--stdio"],
  "permissions": {
    "readPaths": [],
    "writePaths": [],
    "registry": [],
    "network": false,
    "elevation": "none"
  },
  "actions": [
    { "id": "preview", "label": "预览", "write": false },
    { "id": "read_elevated", "label": "读取受限传感器（需 UAC）", "write": false }
  ],
  "limits": { "timeoutMs": 180000, "maxOutputBytes": 2097152 },
  "ui": { "kind": "table" },
  "rollback": "none",
  "hash": "",
  "signature": null
}
