{
  "schemaVersion": 1,
  "id": "proc_opt",
  "name": "电脑智能防卡顿",
  "version": "0.2.0",
  "apiVersion": 1,
  "description": "列出高占用进程，可逐项调整优先级或结束进程（系统关键进程受保护）",
  "category": "optimize",
  "risk": "system",
  "entry": "proc_opt.exe",
  "arguments": ["--stdio"],
  "permissions": {
    "readPaths": [],
    "writePaths": [],
    "registry": [],
    "network": false,
    "elevation": "none"
  },
  "actions": [
    { "id": "preview", "label": "预览", "write": false },
    { "id": "set_priority", "label": "调整进程优先级", "write": true, "requiresConfirmation": true },
    { "id": "end_process", "label": "结束进程", "write": true, "requiresConfirmation": true }
  ],
  "limits": { "timeoutMs": 60000, "maxOutputBytes": 1048576 },
  "ui": { "kind": "table" },
  "rollback": "none",
  "hash": "",
  "signature": null
}
